# Kopieer naar .env (staat in .gitignore) en vul in.
# Supabase-dashboard › Project Settings › API.
# ALLEEN de project-URL en de publishable (of legacy "anon") key. NOOIT de secret/service_role key.
VITE_SUPABASE_URL=https://jouw-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Lokaal met `supabase start`: gebruik de API URL en anon/publishable key die het commando toont, bv.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
